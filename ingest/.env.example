# Required for backend writes (WriterAgent / BackendClient)
# Must match the value configured in neobanker-backend-MVP-V2
AGENT_INTERNAL_KEY=

# Required for Anthropic LLM extraction (AnthropicClient)
ANTHROPIC_API_KEY=

# Optional: override backend base URL (default: http://127.0.0.1:8080)
# BACKEND_BASE_URL=http://127.0.0.1:8080

# Optional: Ollama base URL for local LLM (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Qdrant URL for vector dedup (default: http://localhost:6333)
# QDRANT_URL=http://localhost:6333
