MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=neobanker
MYSQL_APP_USER=neobanker_backend
MYSQL_APP_PASSWORD=neobanker_backend_password

MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: set these when you have local/remote services.
ELASTICSEARCH_URI=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DEFAULT_BUCKET=neobanker

# 1: start local mariadb/redis automatically when possible. 0: skip.
AUTO_START_LOCAL_SERVICES=1
