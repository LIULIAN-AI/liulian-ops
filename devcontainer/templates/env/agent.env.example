# This must match AGENT_INTERNAL_KEY in backend.env.
AGENT_INTERNAL_KEY=change-me-in-dev

# Used by /agent/settings and /agent/settings/provider.
NEOBANKER_PRESENTATION_KEY=dev-presentation-key

# Demo mode avoids external LLM dependency in quick dev bootstraps.
NEOBANKER_DEMO_MODE=1

AGENT_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

AGENT_DEV_COMMAND="source .venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
