# This must match AGENT_INTERNAL_KEY in agent.env.
AGENT_INTERNAL_KEY=change-me-in-dev

# Backend runs directly in Codespaces and reaches agent via localhost.
AGENT_SERVICE_URL=http://localhost:8000

# Spring Boot dev run command on host.
BACKEND_RUN_COMMAND="./mvnw spring-boot:run -Dspring-boot.run.arguments=--spring.devtools.restart.enabled=true"
