# LIULIAN dev environment overrides. Copy to .env and fill in.
#
#   cp .env.example .env
#   # edit .env, then:
#   make dev

# ── LLM provider keys (any 1+ enables that provider) ──────────────────
# Cheapest production-grade default per ADR 0002.
DEEPSEEK_API_KEY=

# Zhipu (chinese tasks)
GLM_API_KEY=

# Google (long context + multimodal)
GEMINI_API_KEY=

# Anthropic (high-quality reasoning, M2+)
ANTHROPIC_API_KEY=

# ── Sovereign / offline path ──────────────────────────────────────────
# Set LIULIAN_OFFLINE=1 to force agent to use local Ollama only
LIULIAN_OFFLINE=0

# ── Host file ownership (auto-detected by make targets) ───────────────
# USER_UID and USER_GID are set automatically by the Makefile.

# ── Cluster (UBELIX) ──────────────────────────────────────────────────
# Used by liulianctl deploy ... over SSH; copy from your existing setup.
# UBELIX_HOST=submit03.unibe.ch
# UBELIX_USER=lj22u267
